/* programme-picker 组件：全屏专业搜索浮层
   样式复刻自 planner.ps-overlay（自包含，planner 暂未迁移到组件）。
   CSS 变量（--surface / --page-bg …）由全局 tokens.wxss 提供，组件运行时继承，不受 styleIsolation 影响。 */

.ps-search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 80rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--border-hair);
  background: var(--surface);
  border-radius: var(--radius-entry);
  box-sizing: border-box;
}
.ps-search-icon {
  flex-shrink: 0;
  font-size: 30rpx;
  line-height: 1;
  opacity: 0.7;
}
.ps-search-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--text-primary);
  background: transparent;
}
.ps-search-ph {
  color: var(--text-secondary);
}
.ps-search-hint {
  margin-top: 12rpx;
  padding: 0 4rpx;
  font-size: var(--fs-link);
  color: var(--text-secondary);
  line-height: 1.45;
}

.ps-empty {
  padding: 80rpx 36rpx;
  text-align: center;
  color: var(--text-secondary);
}
.ps-empty-icon {
  font-size: 56rpx;
  opacity: 0.4;
}
.ps-empty-text {
  margin-top: 16rpx;
  font-size: var(--fs-link);
  line-height: 1.5;
}

.ps-overlay {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--page-bg);
}
.ps-overlay-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  padding: 14rpx 28rpx;
  border-bottom: 1rpx solid var(--divider);
  background: var(--surface);
  box-sizing: border-box;
}
.ps-overlay-bar-spacer {
  width: 64rpx;
  flex: 0 0 64rpx;
}
.ps-overlay-title {
  flex: 1;
  text-align: center;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
}
.ps-overlay-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  background: var(--segmented-bg);
  color: var(--text-primary);
  font-size: 38rpx;
  font-weight: 400;
  line-height: 64rpx;
}
.ps-overlay-search {
  padding: 18rpx 28rpx;
}
.ps-overlay-list {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx 40rpx;
}

.ps-group-card {
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-hair);
  background: var(--surface);
  border-radius: var(--radius-entry);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.ps-group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx 16rpx;
  background: #F4F8F2;
}
.ps-group-name {
  flex: 1;
  color: var(--text-secondary);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}
.ps-group-count {
  min-width: 48rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--surface);
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
}
.ps-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
}
.ps-row + .ps-row {
  border-top: 1rpx solid var(--border-hair);
}
.ps-row-selected {
  background: var(--pill-green-bg);
  box-shadow: inset 5rpx 0 0 var(--accent-green);
}
.ps-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}
.ps-row-name {
  display: block;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.42;
  white-space: normal;
}
.ps-row-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ps-row-badge {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--cat-emerald);
  color: var(--cat-emerald);
  font-size: 20rpx;
  font-weight: 700;
}
.ps-row-code {
  color: #7E8B80;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}
.ps-row-check {
  flex: 0 0 auto;
  color: var(--accent-green);
  font-size: 34rpx;
  font-weight: 700;
}

/* inline 模式:列表区无 scroll-view,由外层引导 ob-scroll 滚动 */
.ps-inline-list {
  padding-top: 16rpx;
}
