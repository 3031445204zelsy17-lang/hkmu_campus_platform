<app-header bind:languagechange="handleLanguageChange" />

<!-- 屏④:新生引导(无 programme 时全屏接管,替代突然弹选专业)。T04 骨架;步骤内容 T05/T06 填 -->
<view wx:if="{{onboarding.active}}" class="ob-screen">
  <view class="ob-nav" style="padding-top: {{onboarding.statusBar}}px;">
    <view class="ob-nav-title">{{text.obTitle}}</view>
  </view>
  <scroll-view scroll-y class="ob-scroll">
    <view class="ob-prog">
      <view class="ob-prog-seg {{onboarding.step>=1?'on':''}}"></view>
      <view class="ob-prog-seg {{onboarding.step>=2?'on':''}}"></view>
      <view class="ob-prog-seg {{onboarding.step>=3?'on':''}}"></view>
    </view>
    <block wx:if="{{onboarding.step===1}}">
      <view class="ob-q">{{text.obStep1Q}}</view>
      <view class="ob-sub">{{text.obStep1Sub}}</view>
      <view class="ob-placeholder">[T05] 选专业 · programme-picker</view>
    </block>
    <block wx:elif="{{onboarding.step===2}}">
      <view class="ob-q">{{text.obStep2Q}}</view>
      <view class="ob-sub">{{text.obStep2Sub}}</view>
      <view class="ob-placeholder">[T05] 选入学学期</view>
    </block>
    <block wx:elif="{{onboarding.step===3}}">
      <view class="ob-q">{{text.obStep3Q}}</view>
      <view class="ob-sub">{{text.obStep3Sub}}</view>
      <view class="ob-placeholder">[T06] 生成课表</view>
    </block>
  </scroll-view>
  <view class="ob-next">
    <view class="ob-next-btns">
      <view wx:if="{{onboarding.step>1}}" class="ob-btn" hover-class="ob-btn-hover" bindtap="onObBack">{{text.obPrev}}</view>
      <view class="ob-btn pri" hover-class="ob-btn-hover" bindtap="onObNext">{{onboarding.step<3 ? text.obNext : text.obFinish}}</view>
    </view>
  </view>
</view>

<view class="page-shell planner-shell">
  <view class="top-bar tight">
    <view class="brand-lockup">
      <view class="eyebrow">{{text.eyebrow}}</view>
      <view class="app-title">{{text.title}}</view>
      <view class="subtitle">{{text.subtitle}}</view>
    </view>
  </view>

  <!-- Hero：专业名（纯展示）+ 总进度。换专业入口移至 profile 页（T03）；首次无专业时由 _maybePromptProgramme 自动弹引导浮层 -->
  <view class="planner-hero {{loggedIn && !comingSoon && viewMode==='planning' ? 'has-score' : ''}}">
    <view class="planner-hero-info">
      <view class="planner-kicker">{{programmeSchool}}</view>
      <view class="planner-title-row">
        <text class="planner-title">{{programmeName}}</text>
      </view>
      <view class="planner-copy">
        <block wx:if="{{viewMode==='catalogue'}}">{{text.catalogueHeroCopy}}</block>
        <block wx:elif="{{loggedIn && !comingSoon}}">{{creditsSummary}}</block>
        <block wx:elif="{{comingSoon}}">{{text.comingSoonCopy}}</block>
        <block wx:else>{{text.heroCopy}}</block>
      </view>
    </view>
    <view wx:if="{{loggedIn && !comingSoon && viewMode==='planning'}}" class="planner-score">{{percent}}%</view>
  </view>

  <!-- 总览/我的课程 切换 -->
  <view wx:if="{{showTabs}}" class="seg-bar">
    <view class="seg-item {{activeTab==='overview'?'seg-on':''}}" data-tab="overview" bindtap="onTabChange">{{text.tabOverview}}</view>
    <view class="seg-item {{activeTab==='courses'?'seg-on':''}}" data-tab="courses" bindtap="onTabChange">{{text.tabCourses}}</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="web-panel">
    <view class="panel-copy">{{text.loading}}</view>
  </view>

  <!-- 课程目录（非完整规划专业：全校 ~106 专业官方课程列表） -->
  <view wx:elif="{{viewMode==='catalogue'}}" class="planner-catalogue">
    <view class="catalogue-disclaimer">{{catalogueDisclaimer}}</view>

    <view wx:if="{{catalogueLoading}}" class="web-panel">
      <view class="panel-copy">{{text.loading}}</view>
    </view>

    <view wx:elif="{{catalogueLoadError}}" class="web-panel">
      <view class="panel-copy">{{catalogueLoadError}}</view>
    </view>

    <block wx:else>
      <view class="web-panel catalogue-stats">
        <view class="cat-stat">
          <text class="cat-stat-num">{{catalogueTotal}}</text>
          <text class="cat-stat-label">{{text.totalCourses}}</text>
        </view>
        <view class="cat-stat">
          <text class="cat-stat-num">{{catalogueBuckets.length}}</text>
          <text class="cat-stat-label">{{text.catalogueGroupCount}}</text>
        </view>
      </view>

      <view wx:for="{{catalogueBuckets}}" wx:for-item="b" wx:key="key" class="web-panel">
        <view class="section-title">{{b.label}} ({{b.total}})</view>
        <view wx:for="{{b.courses}}" wx:for-item="c" wx:key="code" class="course-row catalogue-row">
          <view class="course-main">
            <view class="course-code">{{c.code}}</view>
            <view class="course-name">{{c.name}} · {{c.credits}}cr</view>
          </view>
          <view class="mini-pill gray">{{c.system}}</view>
        </view>
        <view wx:if="{{b.collapsed}}" class="catalogue-showall" data-bucket="{{b.key}}" bindtap="onToggleBucket">{{b.showAllLabel}}</view>
      </view>
    </block>
  </view>

  <!-- 敬请期待（占位专业） -->
  <view wx:elif="{{comingSoon}}" class="web-panel">
    <view class="section-title">{{text.comingSoonTitle}}</view>
    <view class="panel-copy">{{text.comingSoonCopy}}</view>
  </view>

  <!-- 未登录 -->
  <view wx:elif="{{!loggedIn}}" class="web-panel planner-login">
    <view class="section-title">{{text.loginPromptTitle}}</view>
    <view class="panel-copy">{{text.loginPromptCopy}}</view>
    <view class="planner-cta" bindtap="goLogin">{{text.loginAction}}</view>

    <view wx:if="{{categoriesView.length}}" class="section-title planner-subtitle">{{text.categoriesTitle}}</view>
    <view
      wx:for="{{categoriesView}}"
      wx:key="key"
      class="category-row"
    >
      <view class="category-head">
        <text class="category-name">{{item.label}}</text>
        <text class="category-credits">{{text.requiredCredits}}{{item.required}} cr</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: 0%"></view>
      </view>
      <view wx:if="{{item.hasGePool}}" class="ge-entry" bindtap="onOpenGePicker" hover-class="ge-entry-hover">
        <text>{{text.geSelectEntry}}</text>
        <text class="ge-entry-arrow">▸</text>
      </view>
    </view>
  </view>

  <!-- 已登录：毕业仪表盘 -->
  <block wx:elif="{{activeTab==='overview'}}">
    <view class="web-panel">
      <view class="section-title">{{text.progressTitle}}</view>
      <view class="credits-summary">{{creditsSummary}}</view>
      <view class="progress-track progress-track-lg">
        <view class="progress-fill" style="width: {{percent}}%"></view>
      </view>
    </view>

    <view class="web-panel">
      <view class="section-title">{{text.categoriesTitle}}</view>
      <view
        wx:for="{{categoriesView}}"
        wx:key="key"
        class="category-row"
      >
        <view class="category-head">
          <text class="category-name">{{item.label}}</text>
          <text class="category-credits">{{item.earned}}/{{item.required}} cr</text>
        </view>
        <view class="progress-track">
          <view class="progress-fill cat-{{item.color}}" style="width: {{item.pct}}%"></view>
        </view>
        <view wx:if="{{item.hasGePool}}" class="ge-entry" bindtap="onOpenGePicker" hover-class="ge-entry-hover">
          <text>{{text.geSelectEntry}}</text>
          <text class="ge-entry-arrow">▸</text>
        </view>
      </view>
    </view>

    <view wx:if="{{recommendations.length}}" class="web-panel">
      <view class="section-title">{{text.recommendTitle}}</view>
      <view
        wx:for="{{recommendations}}"
        wx:key="course_id"
        class="course-row"
      >
        <view class="course-main">
          <view class="course-code">{{item.code}}</view>
          <view class="course-name">{{item.name}} · {{item.credits}}cr</view>
        </view>
        <view class="mini-pill green">{{item.categoryLabel}}</view>
      </view>
    </view>
  </block>

  <!-- 我的课程:按学年学期分组 + 搜索 + 标记 -->
  <block wx:elif="{{activeTab==='courses'}}">
    <view class="web-panel planner-search">
      <input class="search-input" value="{{searchKeyword}}"
             placeholder="{{text.searchPlaceholder}}" bindinput="onSearchInput" />
    </view>

    <block wx:for="{{coursesView.semesters}}" wx:for-item="sem" wx:key="label">
      <view class="sem-header">{{sem.label}}</view>
      <view wx:for="{{sem.courses}}" wx:for-item="c" wx:key="courseId"
            class="course-row course-tap"
            data-course-id="{{c.courseId}}" data-code="{{c.code}}"
            bindtap="openCourseDetail">
        <view class="course-main">
          <view class="course-code">{{c.code}}</view>
          <view class="course-name">{{c.name}} · {{c.credits}}cr</view>
          <view wx:if="{{c.prereqLabel}}" class="prereq-row {{c.prereqsMet?'met':'unmet'}}">{{c.prereqLabel}}</view>
        </view>
        <view wx:if="{{c.statusKey==='completed'}}" class="mini-pill green">{{c.statusLabel}}</view>
        <view wx:elif="{{c.statusKey==='in_progress'}}" class="mini-pill amber">{{c.statusLabel}}</view>
      </view>
    </block>

    <view wx:if="{{coursesView.empty}}" class="web-panel">
      <view class="panel-copy">{{text.coursesEmpty}}</view>
    </view>
  </block>

  <!-- 全屏专业搜索浮层：点 hero 触发。搜索引导 + 按学院分组卡片，选完或 ✕ 返回 -->
  <view wx:if="{{programmeSearchOpen}}" class="ps-overlay" style="top: {{programmeOverlayTop}}px;">
    <view class="ps-overlay-bar">
      <view class="ps-overlay-bar-spacer"></view>
      <text class="ps-overlay-title">{{text.selectProgramme}}</text>
      <view class="ps-overlay-close" bindtap="onCloseProgrammeSearch">×</view>
    </view>
    <view class="ps-overlay-search">
      <view class="ps-search-wrap">
        <view class="ps-search-icon">🔍</view>
        <input class="ps-search-input" value="{{programmeQuery}}"
               placeholder="{{text.programmeSearchPlaceholder}}"
               placeholder-class="ps-search-ph"
               focus="{{programmeSearchOpen}}"
               bindinput="onProgrammeSearchInput" confirm-type="search" />
      </view>
      <view class="ps-search-hint">{{text.programmeSearchHintPre}}{{programmeTotal}}{{text.programmeSearchHintPost}}</view>
    </view>
    <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="ps-overlay-list">
      <view wx:if="{{programmeSearchEmpty}}" class="ps-empty">
        <view class="ps-empty-icon">🔍</view>
        <view class="ps-empty-text">{{text.programmeSearchEmpty}}</view>
      </view>
      <block wx:for="{{programmeSearchResults}}" wx:for-item="grp" wx:key="school">
        <view class="ps-group-card">
          <view wx:if="{{grp.school}}" class="ps-group-head">
            <text class="ps-group-name">{{grp.school}}</text>
            <text class="ps-group-count">{{grp.programmes.length}}</text>
          </view>
          <view wx:for="{{grp.programmes}}" wx:for-item="p" wx:key="code"
                class="ps-row {{p.selected?'ps-row-selected':''}}"
                data-code="{{p.code}}" bindtap="onSelectProgramme">
            <view class="ps-row-main">
              <text class="ps-row-name">{{p.name}}</text>
              <view class="ps-row-meta">
                <text class="ps-row-code">{{p.code}}</text>
                <text wx:if="{{p.badge}}" class="ps-row-badge">{{p.badge}}</text>
              </view>
            </view>
            <text wx:if="{{p.selected}}" class="ps-row-check">✓</text>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- GE 通识选择浮层（屏③）：点通识分类行的"选择"入口触发。复用 ps-overlay 骨架 -->
  <view wx:if="{{gePicker.open}}" class="ps-overlay ge-overlay" style="top: {{programmeOverlayTop}}px;">
    <view class="ps-overlay-bar">
      <view class="ps-overlay-bar-spacer"></view>
      <text class="ps-overlay-title">{{gePicker.title}}</text>
      <view class="ps-overlay-close" bindtap="onCloseGePicker">×</view>
    </view>

    <view wx:if="{{gePicker.loadError}}" class="web-panel ge-panel-msg">
      <view class="panel-copy">{{gePicker.loadError}}</view>
    </view>

    <block wx:elif="{{gePicker.loading}}">
      <view class="web-panel ge-panel-msg">
        <view class="panel-copy">{{text.loading}}</view>
      </view>
    </block>

    <scroll-view wx:else scroll-y enhanced show-scrollbar="{{false}}" class="ge-overlay-list">
      <view class="ge-note">{{gePicker.ruleNote}}</view>
      <view class="ge-progress">{{gePicker.progress}}</view>

      <view
        wx:for="{{gePicker.fields}}"
        wx:for-item="fld"
        wx:key="name"
        class="ge-field {{fld.blocked ? 'ge-field-blk' : ''}}"
      >
        <view class="ge-field-h">
          <text class="ge-field-name">{{fld.name}}</text>
          <text class="ge-field-ct">{{fld.headRight}}</text>
        </view>
        <view
          wx:for="{{fld.courses}}"
          wx:for-item="c"
          wx:key="id"
          class="ge-row {{c.taken ? 'ge-row-taken' : ''}} {{c.blocked ? 'ge-row-blocked' : ''}}"
          data-id="{{c.id}}"
          data-blocked="{{c.blocked}}"
          bindtap="onToggleGeCourse"
        >
          <text class="ge-code">{{c.code}}</text>
          <text class="ge-name">{{c.name}}</text>
          <text wx:if="{{c.taken}}" class="ge-mark ge-mark-done">✓</text>
          <text wx:elif="{{c.blocked}}" class="ge-mark ge-mark-blk">⊘</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
