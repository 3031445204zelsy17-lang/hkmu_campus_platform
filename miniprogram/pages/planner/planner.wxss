/* pages/planner/planner.wxss
   页面级样式，全部走 styles/tokens.wxss 的 var()。
   复用 app.wxss 的 web-panel / section-title / panel-copy / course-row /
   course-code / course-name / mini-pill / planner-hero / planner-score 等。
   分类配色（cat-*）为与 web planner 对齐的 6 色，作为页面局部 var 定义在此，
   不动共享 tokens.wxss；将来若全局复用可迁回。 */

.planner-shell {
  --cat-blue: #3B82F6;
  --cat-purple: #8B5CF6;
  --cat-amber: #F59E0B;
  --cat-emerald: #10B981;
  --cat-pink: #EC4899;
  --cat-indigo: #6366F1;
  padding-top: 0;
}

.planner-shell .top-bar.tight {
  padding: 28rpx 0 24rpx;
}

.planner-shell .web-panel {
  margin-left: 0;
  margin-right: 0;
}

.planner-shell .planner-hero {
  position: relative;
  display: block;
  margin: 0 0 22rpx;
  padding: 32rpx;
  border-radius: var(--radius-card-lg);
}

.planner-shell .planner-title {
  font-size: 38rpx;
  line-height: 1.28;
}

.planner-shell .planner-copy {
  color: rgba(255, 255, 255, 0.88);
}

.planner-shell .planner-hero.has-score .planner-copy {
  padding-right: 112rpx;
}

.planner-shell .planner-score {
  position: absolute;
  right: 32rpx;
  bottom: 28rpx;
  width: auto;
  min-width: 80rpx;
  height: 52rpx;
  padding: 0 16rpx;
  border-width: 2rpx;
  border-radius: var(--radius-pill);
  font-size: 26rpx;
  line-height: 52rpx;
  box-sizing: border-box;
}

/* 专业选择器 */
.selector-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: var(--segmented-bg);
  border-radius: var(--radius-entry);
}

.selector-text {
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
}

.selector-caret {
  color: var(--text-secondary);
  font-size: var(--fs-body);
}

/* 总进度 */
.credits-summary {
  color: var(--text-primary);
  font-size: var(--fs-feed-body);
  font-weight: 600;
  margin: 8rpx 0 20rpx;
}

.progress-track {
  width: 100%;
  height: 14rpx;
  border-radius: var(--radius-pill);
  background: var(--border-soft);
  overflow: hidden;
}

.progress-track-lg {
  height: 20rpx;
}

.progress-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--accent-blue);
  transition: width 0.3s ease;
}

/* 分类行 */
.category-row {
  padding: 20rpx 0;
}

.category-row + .category-row {
  border-top: 1rpx solid var(--divider);
}

.category-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.category-name {
  color: var(--text-primary);
  font-size: var(--fs-body);
  font-weight: 600;
}

.category-credits {
  color: var(--text-secondary);
  font-size: var(--fs-link);
}

/* 分类配色 */
.cat-blue { background: var(--cat-blue); }
.cat-purple { background: var(--cat-purple); }
.cat-amber { background: var(--cat-amber); }
.cat-emerald { background: var(--cat-emerald); }
.cat-pink { background: var(--cat-pink); }
.cat-indigo { background: var(--cat-indigo); }

/* 未登录卡 */
.planner-login .planner-subtitle {
  margin-top: 32rpx;
}

.planner-cta {
  display: inline-block;
  margin-top: 24rpx;
  padding: 18rpx 40rpx;
  background: var(--accent-blue);
  color: #ffffff;
  font-size: var(--fs-btn);
  font-weight: 600;
  border-radius: var(--radius-pill);
  box-shadow: var(--shadow-btn-primary);
}

/* 推荐卡片课程主区 */
.course-main {
  display: flex;
  flex-direction: column;
}

/* segmented 总览/我的课程 */
.seg-bar {
  display: flex;
  gap: 8rpx;
  margin: 0 0 22rpx;
  background: var(--segmented-bg);
  border-radius: var(--radius-pill);
  padding: 6rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: var(--radius-pill);
  color: var(--text-secondary);
  font-size: var(--fs-link);
  font-weight: 600;
}
.seg-on {
  background: var(--surface, #ffffff);
  color: var(--text-primary);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

/* 搜索框 */
.planner-search {
  padding: 8rpx 0;
}
.search-input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  background: var(--segmented-bg);
  border-radius: var(--radius-entry);
  font-size: var(--fs-body);
  color: var(--text-primary);
}

/* 学期分组头 */
.sem-header {
  margin: 24rpx 4rpx 12rpx;
  color: var(--text-secondary);
  font-size: var(--fs-link);
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 课程卡点击反馈 */
.course-tap {
  transition: background 0.15s;
}
.course-tap:active {
  background: var(--segmented-bg);
}

/* 先修提示 */
.prereq-row {
  margin-top: 6rpx;
  font-size: 22rpx;
}
.prereq-row.met {
  color: var(--cat-emerald);
}
.prereq-row.unmet {
  color: var(--text-secondary);
}

/* 状态 pill:进行中 amber(已完成 green 已在 app.wxss) */
.mini-pill.amber {
  background: var(--cat-amber);
  color: #ffffff;
}

/* 课程目录（非完整规划专业） */
.catalogue-disclaimer {
  margin: 0 0 24rpx;
  padding: 20rpx 24rpx;
  background: var(--segmented-bg);
  border-left: 6rpx solid var(--cat-amber);
  border-radius: var(--radius-entry);
  font-size: var(--fs-link);
  color: var(--text-primary);
  line-height: 1.5;
}
.catalogue-stats {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
}
.cat-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cat-stat-num {
  font-size: var(--fs-title);
  font-weight: 700;
  color: var(--text-primary);
}
.cat-stat-label {
  margin-top: 4rpx;
  font-size: var(--fs-link);
  color: var(--text-secondary);
}
.mini-pill.gray {
  background: var(--segmented-bg);
  color: var(--text-secondary);
}
.catalogue-showall {
  margin-top: 16rpx;
  padding: 12rpx 0;
  font-size: var(--fs-link);
  color: var(--accent-blue);
  text-align: left;
}

/* 专业搜索：hero 触发 → 全屏浮层（默认收起，不再常驻霸屏） */
/* 搜索框：品牌绿浅底 + 左侧图标，浮层打开后最醒目的锚点 */
.ps-search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 80rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--border-hair);
  background: var(--surface);
  border-radius: var(--radius-entry);
  box-sizing: border-box;
}
.ps-search-icon {
  flex-shrink: 0;
  font-size: 30rpx;
  line-height: 1;
  opacity: 0.7;
}
.ps-search-input {
  flex: 1;
  min-width: 0;
  font-size: var(--fs-body);
  color: var(--text-primary);
  background: transparent;
}
.ps-search-ph {
  color: var(--text-secondary);
}
.ps-search-hint {
  margin-top: 12rpx;
  padding: 0 4rpx;
  font-size: var(--fs-link);
  color: var(--text-secondary);
  line-height: 1.45;
}

/* 空状态 */
.ps-empty {
  padding: 80rpx 36rpx;
  text-align: center;
  color: var(--text-secondary);
}
.ps-empty-icon {
  font-size: 56rpx;
  opacity: 0.4;
}
.ps-empty-text {
  margin-top: 16rpx;
  font-size: var(--fs-link);
  line-height: 1.5;
}

/* hero 信息区：点击切换专业 */
.planner-hero-info {
  flex: 1;
  min-width: 0;
}
.planner-hero-hover {
  opacity: 0.85;
}
.planner-title-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 14rpx;
}
.planner-title-caret {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
  font-weight: 700;
}

/* 全屏专业搜索浮层 */
.ps-overlay {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--page-bg);
}
.ps-overlay-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  padding: 14rpx 28rpx;
  border-bottom: 1rpx solid var(--divider);
  background: var(--surface);
  box-sizing: border-box;
}
.ps-overlay-bar-spacer {
  width: 64rpx;
  flex: 0 0 64rpx;
}
.ps-overlay-title {
  flex: 1;
  text-align: center;
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 700;
}
.ps-overlay-close {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 64rpx;
  background: var(--segmented-bg);
  color: var(--text-primary);
  font-size: 38rpx;
  font-weight: 400;
  line-height: 64rpx;
}
.ps-overlay-search {
  padding: 18rpx 28rpx;
}
.ps-overlay-list {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx 40rpx;
}
/* 学院分组卡片：圆角 + 阴影，替代逐行 border-top 平铺 */
.ps-group-card {
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-hair);
  background: var(--surface);
  border-radius: var(--radius-entry);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}
.ps-group-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx 16rpx;
  background: #F4F8F2;
}
.ps-group-name {
  flex: 1;
  color: var(--text-secondary);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.35;
}
.ps-group-count {
  min-width: 48rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-pill);
  background: var(--surface);
  color: var(--text-secondary);
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
}
.ps-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 24rpx;
}
.ps-row + .ps-row {
  border-top: 1rpx solid var(--border-hair);
}
.ps-row-selected {
  background: var(--pill-green-bg);
  box-shadow: inset 5rpx 0 0 var(--accent-green);
}
.ps-row-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}
.ps-row-name {
  display: block;
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.42;
  white-space: normal;
}
.ps-row-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ps-row-badge {
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  border: 1rpx solid var(--cat-emerald);
  color: var(--cat-emerald);
  font-size: 20rpx;
  font-weight: 700;
}
.ps-row-code {
  color: #7E8B80;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
}
.ps-row-check {
  flex: 0 0 auto;
  color: var(--accent-green);
  font-size: 34rpx;
  font-weight: 700;
}
