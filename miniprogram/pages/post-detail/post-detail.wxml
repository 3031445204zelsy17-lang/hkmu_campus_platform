<app-header show-back="{{true}}" title="{{text.headerTitle}}" bind:languagechange="handleLanguageChange" />

<view class="page-shell detail-shell">
  <view wx:if="{{loading}}" class="loading-line">{{text.loading}}</view>

  <view wx:elif="{{notFound}}" class="empty-state">
    <view class="empty-title">{{text.notFoundTitle}}</view>
    <view class="empty-copy">{{text.notFoundCopy}}</view>
  </view>

  <block wx:elif="{{post}}">
    <view class="feed-card detail-card">
      <view class="feed-head">
        <view class="avatar" data-author-id="{{post.authorId}}" catchtap="openDM" bindlongpress="onReportAuthor">
          <image wx:if="{{post.authorAvatar}}" src="{{post.authorAvatar}}" mode="aspectFill" binderror="onAuthorAvatarError" />
          <text wx:else>{{post.authorInitial}}</text>
        </view>
        <view class="feed-main">
          <view class="feed-author-row">
            <view>
              <view class="feed-author">{{post.authorName}}</view>
              <view class="feed-meta">{{post.handle}} {{text.feedMetaSeparator}} {{post.createdAtLabel}}</view>
            </view>
            <view class="{{post.topicClass}}">{{post.category}}</view>
          </view>
          <view class="feed-title">{{post.title}}</view>
          <image wx:if="{{post.imageUrl}}" class="feed-image" src="{{post.imageUrl}}" mode="widthFix" />
          <view class="feed-body">{{post.content}}</view>
          <view class="post-actions">
            <view class="{{post.likeClass}}" catchtap="toggleLike" hover-class="post-action-press">
              <text class="{{post.likeIconClass}}">{{post.likeIcon}}</text>
              <text class="post-action-count">{{post.likeLabel}}</text>
            </view>
            <button class="post-action share-action" open-type="share" hover-class="post-action-press" aria-label="{{text.shareAction}}">
              <text class="social-glyph">↗</text>
              <text class="post-action-count">{{text.shareAction}}</text>
            </button>
            <view wx:if="{{user && (post.authorId === user.id || user.isAdmin)}}" class="post-action delete-action" catchtap="onDeletePost" hover-class="post-action-press">
              <text class="social-glyph">🗑</text>
              <text class="post-action-count">{{text.deleteAction}}</text>
            </view>
            <view wx:if="{{user && post.authorId !== user.id && !reportSubmitted}}" class="post-action report-action" catchtap="onReportPost" hover-class="post-action-press">
              <text class="social-glyph">🚩</text>
              <text class="post-action-count">{{text.reportAction}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="comment-section">
      <view class="comment-header">{{text.commentCountLabel}} · {{commentsTotal}}</view>

      <view wx:if="{{commentsLoading}}" class="comment-status">{{text.commentLoading}}</view>
      <block wx:else>
        <view wx:if="{{comments.length === 0}}" class="comment-status">{{text.commentEmpty}}</view>
        <view wx:for="{{comments}}" wx:key="id" wx:for-index="idx" class="comment-item" bindlongpress="onReportComment" data-id="{{item.id}}">
          <view class="comment-avatar" data-author-id="{{item.authorId}}" catchtap="openDM">
            <image wx:if="{{item.authorAvatar}}" src="{{item.authorAvatar}}" mode="aspectFill" binderror="onCommentAvatarError" data-idx="{{idx}}" />
            <text wx:else>{{item.authorInitial}}</text>
          </view>
          <view class="comment-main">
            <view class="comment-author">{{item.authorName}}</view>
            <view class="comment-content">{{item.content}}</view>
            <image wx:if="{{item.imageUrl}}" class="comment-image" src="{{item.imageUrl}}" mode="widthFix" catchtap="previewCommentImage" data-url="{{item.imageUrl}}" />
            <view class="comment-meta">
              <text>{{item.createdAtLabel}}</text>
              <text class="comment-reply-btn" catchtap="startReply" data-id="{{item.id}}" data-name="{{item.authorName}}">{{text.reply}}</text>
            </view>

            <view wx:if="{{item.replies.length}}" class="comment-replies">
              <view wx:for="{{item.replies}}" wx:for-item="reply" wx:key="id" class="comment-reply-item" bindlongpress="onReportComment" data-id="{{reply.id}}">
                <view class="comment-reply-head">
                  <text class="comment-reply-author">{{reply.authorName}}</text>
                  <text wx:if="{{reply.replyToName && reply.replyToName !== item.authorName}}" class="comment-reply-hint">{{text.reply}} @{{reply.replyToName}}</text>
                </view>
                <view wx:if="{{reply.content}}" class="comment-reply-content">{{reply.content}}</view>
                <image wx:if="{{reply.imageUrl}}" class="comment-image" src="{{reply.imageUrl}}" mode="widthFix" catchtap="previewCommentImage" data-url="{{reply.imageUrl}}" />
                <view class="comment-meta">
                  <text>{{reply.createdAtLabel}}</text>
                  <text class="comment-reply-btn" catchtap="startReply" data-id="{{reply.id}}" data-name="{{reply.authorName}}">{{text.reply}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{user}}" class="comment-composer detail-composer">
      <view wx:if="{{replyTarget}}" class="composer-reply-bar">
        <text class="composer-reply-text">{{text.reply}} @{{replyTarget.name}}</text>
        <text class="composer-reply-cancel" catchtap="cancelReply">✕</text>
      </view>
      <view wx:if="{{commentImage}}" class="composer-image-wrap">
        <image class="composer-image-preview" src="{{commentImage}}" mode="aspectFill" />
        <text class="composer-image-remove" catchtap="removeCommentImage">✕</text>
      </view>
      <view class="composer-row">
        <textarea
          class="comment-textarea"
          placeholder="{{text.commentPlaceholder}}"
          value="{{draft}}"
          maxlength="500"
          auto-height
          show-confirm-bar="{{false}}"
          bindinput="updateDraft"
        />
        <view class="composer-image-btn" catchtap="chooseCommentImage">📷</view>
        <view class="comment-send {{submitting ? 'is-busy' : ''}}" catchtap="submitComment">{{text.commentSend}}</view>
      </view>
    </view>
    <view wx:else class="login-prompt" catchtap="goLogin">{{text.loginPrompt}}</view>
  </block>
</view>
