/* pages/post-detail/post-detail.wxss — page-scoped, token-only */

.detail-shell {
  padding-bottom: var(--shell-bottom);
}

.detail-card {
  margin: 0 0 24rpx;
}

/* === Comments (migrated from community Phase 1 ③ → ⑦) === */
.comment-section {
  margin: 24rpx 0 0;
  padding: 28rpx 28rpx 24rpx;
  border-radius: var(--radius-card-md);
  background: var(--surface);
  border: 1rpx solid var(--border-hair);
  box-shadow: var(--shadow-card);
}

.comment-header {
  padding-bottom: 18rpx;
  font-size: var(--fs-section);
  font-weight: 700;
  color: var(--text-primary);
  border-bottom: 1rpx solid var(--divider);
}

.comment-status {
  padding: 28rpx 0;
  font-size: var(--fs-feed-meta);
  color: var(--text-secondary);
  text-align: center;
}

.comment-item {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--divider);
}
.comment-item:last-of-type {
  border-bottom: none;
}

.comment-avatar {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: var(--hero-gradient);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 有头像时 <image> 必须被圆框裁切(对齐 app.wxss .avatar 的做法) */
  overflow: hidden;
}

.comment-avatar image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.comment-main {
  flex: 1;
  min-width: 0;
}
.comment-author {
  font-size: var(--fs-feed-meta);
  font-weight: 650;
  color: var(--text-primary);
}
.comment-content {
  margin-top: 6rpx;
  font-size: var(--fs-feed-body);
  line-height: 1.5;
  color: var(--text-primary);
  word-break: break-word;
}
.comment-meta {
  margin-top: 8rpx;
  font-size: var(--fs-link);
  color: var(--text-secondary);
}

/* === Comment replies (two-layer tree) === */
.comment-replies {
  margin-top: 14rpx;
  padding-left: 18rpx;
  border-left: 4rpx solid var(--divider);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.comment-reply-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  flex-wrap: wrap;
}
.comment-reply-author {
  font-size: var(--fs-feed-meta);
  font-weight: 650;
  color: var(--text-primary);
}
.comment-reply-hint {
  font-size: var(--fs-link);
  color: var(--text-secondary);
}
.comment-reply-content {
  margin-top: 4rpx;
  font-size: var(--fs-feed-body);
  line-height: 1.5;
  color: var(--text-primary);
  word-break: break-word;
}
.comment-reply-btn {
  margin-left: 16rpx;
  color: var(--text-secondary);
}

.comment-image {
  margin-top: 10rpx;
  width: 320rpx;
  border-radius: var(--radius-card-md);
}

/* === Composer === */
.detail-composer {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  margin: 24rpx 0 0;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-entry);
  background: var(--surface);
  border: 1rpx solid var(--border-soft);
  box-shadow: var(--shadow-card);
}

.composer-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

/* 回复态提示条:回复 @xxx ✕ */
.composer-reply-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  border-radius: var(--radius-pill);
  background: var(--segmented-bg);
  font-size: var(--fs-link);
  color: var(--text-secondary);
}
.composer-reply-cancel {
  padding: 4rpx 12rpx;
  color: var(--text-secondary);
  font-size: var(--fs-link);
}

/* 已选评论图预览(提交时才上传) */
.composer-image-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
}
.composer-image-preview {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-card-md);
}
.composer-image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 22rpx;
}

.composer-image-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--segmented-bg);
  font-size: 30rpx;
}

.comment-textarea {
  flex: 1;
  min-height: 64rpx;
  max-height: 240rpx;
  padding: 16rpx 22rpx;
  box-sizing: border-box;
  border-radius: var(--radius-pill);
  background: var(--segmented-bg);
  font-size: var(--fs-feed-meta);
  color: var(--text-primary);
}

.comment-send {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-blue);
  color: #FFFFFF;
  font-size: var(--fs-btn);
  font-weight: 650;
  text-align: center;
  box-shadow: var(--shadow-btn-primary);
}
.comment-send.is-busy {
  opacity: var(--press-opacity);
}

.login-prompt {
  margin: 24rpx 0 0;
  padding: 24rpx;
  border-radius: var(--radius-entry);
  background: var(--segmented-bg);
  border: 1rpx dashed var(--border-soft);
  font-size: var(--fs-feed-meta);
  color: var(--accent-blue);
  text-align: center;
}

/* === 转发按钮(post-actions 内原生 button 归一;布局/颜色走全局 .post-action)=== */
.share-action {
  width: auto;
  font-size: inherit;
  font-weight: inherit;
  line-height: 1;
}
