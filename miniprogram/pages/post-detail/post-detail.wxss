}

.icon-flag {
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20stroke%3D%22%232E7D52%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M3%203v1.5M3%2021v-6m0%200l2.77-.693a9%209%200%20016.208.682l.108.054a9%209%200%20006.086.71l3.114-.732a48.524%2048.524%200%2001-.005-10.499l-3.11.732a9%209%200%2001-6.085-.711l-.108-.054a9%209%200%2000-6.208-.682L3%204.5M3%2015V4.5%22%2F%3E%3C%2Fsvg%3E");
}

/* 评论输入栏相机:次级灰 #6B7280 */
.icon-camera {
  width: 36rpx;
  height: 36rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
  background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20stroke%3D%22%236B7280%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20viewBox%3D%220%200%2024%2024%22%3E%3Cpath%20d%3D%22M6.827%206.175A2.31%202.31%200%20015.186%207.23c-.38.054-.757.112-1.134.175C2.999%207.58%202.25%208.507%202.25%209.574V18a2.25%202.25%200%20002.25%202.25h15A2.25%202.25%200%200021.75%2018V9.574c0-1.067-.75-1.994-1.802-2.169a47.865%2047.865%200%2000-1.134-.175%202.31%202.31%200%2001-1.64-1.055l-.822-1.316a2.192%202.192%200%2000-1.736-1.039%2048.774%2048.774%200%2000-5.232%200%202.192%202.192%200%2000-1.736%201.039l-.821%201.316z%22%2F%3E%3Cpath%20d%3D%22M16.5%2012.75a4.5%204.5%200%2011-9%200%204.5%204.5%200%20019%200zM18.75%2010.5h.008v.008h-.008V10.5z%22%2F%3E%3C%2Fsvg%3E");
}

.comment-textarea {
  flex: 1;
  min-height: 64rpx;
  max-height: 240rpx;
  padding: 16rpx 22rpx;
  box-sizing: border-box;
  border-radius: var(--radius-pill);
  background: var(--segmented-bg);
  font-size: var(--fs-feed-meta);
  color: var(--text-primary);
}

.comment-send {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-blue);
  color: #FFFFFF;
  font-size: var(--fs-btn);
  font-weight: 650;
  text-align: center;
  box-shadow: var(--shadow-btn-primary);
}
.comment-send.is-busy {
  opacity: var(--press-opacity);
}

.login-prompt {
  margin: 24rpx 0 0;
  padding: 24rpx;
  border-radius: var(--radius-entry);
  background: var(--segmented-bg);
  border: 1rpx dashed var(--border-soft);
  font-size: var(--fs-feed-meta);
  color: var(--accent-blue);
  text-align: center;
}

/* === 转发按钮(post-actions 内原生 button 归一;布局/颜色走全局 .post-action)=== */
.share-action {
  width: auto;
  font-size: inherit;
  font-weight: inherit;
  line-height: 1;
}
