/* Profile edit mode — page-level styles only, all via tokens.wxss var().
   View-mode styling lives in app.wxss (profile-card / avatar / action-row …). */

.avatar-edit-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 0;
}

/* inline-block so the wrap shrink-wraps the 128rpx avatar; otherwise the
   absolutely-positioned badge would anchor to the full card width. */
.avatar-edit-wrap {
  position: relative;
  display: inline-block;
}

.avatar-edit-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-blue);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  box-shadow: var(--shadow-btn-primary);
}

.avatar-hint {
  margin-top: 16rpx;
  color: var(--text-secondary);
  font-size: var(--fs-link);
}

/* Phase 5: HKMU 已验证徽章(视图模式,name 旁)— 页面级,不动 app.wxss */
.verified-badge {
  display: inline-block;
  margin-left: 12rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--accent-blue);
  color: #ffffff;
  font-size: var(--fs-link);
  vertical-align: middle;
}

/* ── 入学时间修改浮层（仿 T03 换专业;chip 视觉对齐 planner 引导 ob-chip）── */
.et-mask {
  position: fixed;
  inset: 0;
  background: rgba(18, 40, 25, 0.45);
  z-index: 50;
  display: flex;
  align-items: flex-end;
}
.et-sheet {
  width: 100%;
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  padding: 30rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: var(--shadow-card);
}
.et-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}
.et-title {
  font-size: var(--fs-section);
  font-weight: 700;
  color: var(--text-primary);
}
.et-close {
  font-size: 44rpx;
  line-height: 1;
  color: var(--text-secondary);
  padding: 6rpx 10rpx;
}
.et-field-label {
  font-size: var(--fs-segment);
  color: var(--text-secondary);
  font-weight: 600;
  margin: 18rpx 0 14rpx;
}
.et-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.et-chip {
  padding: 14rpx 30rpx;
  border-radius: var(--radius-pill);
  background: var(--surface);
  border: 1rpx solid var(--border-soft);
  color: var(--text-primary);
  font-size: var(--fs-btn);
  font-weight: 600;
}
.et-chip.sel {
  background: var(--accent-blue);
  color: #fffaf0;
  border-color: var(--accent-blue);
}
.et-chip-hover { opacity: 0.86; }
.et-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 34rpx;
}
.et-actions button { flex: 1; }
