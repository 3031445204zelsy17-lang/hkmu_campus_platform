.tabbar-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 850;
  padding: 0 44rpx calc(26rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
}

.tabbar-shell.is-hidden {
  display: none;
}

.tabbar-pill {
  position: relative;
  width: 100%;
  max-width: 704rpx;
  height: 112rpx;
  margin: 0 auto;
  padding: 8rpx 0;
  border: 1rpx solid #D7E4D6;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  gap: 0;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    0 20rpx 56rpx rgba(24, 56, 34, 0.14),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.78);
  /* 不用 backdrop-filter：背景已是 0.94 不透明白，模糊几乎看不出来，但它会为这个
     fixed 元素单独开一个合成层，每次切 tab 重建都要重新合成，是切页闪一下的来源之一。 */
  pointer-events: auto;
  user-select: none;
  -webkit-user-select: none;
}

.tabbar-liquid-capsule {
  position: absolute;
  left: 0;
  top: 50%;
  z-index: 0;
  width: 118rpx;
  height: 88rpx;
  border: 1rpx solid rgba(127, 191, 77, 0.30);
  border-radius: 36rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(240, 247, 237, 0.86)),
    rgba(127, 191, 77, 0.10);
  box-shadow:
    0 8rpx 22rpx rgba(30, 70, 40, 0.08),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.82);
  transform: translate(-50%, -50%);
  transition:
    left 300ms ease-out,
    transform 300ms ease-out,
    box-shadow 300ms ease-out,
    opacity 160ms ease;
}

.tabbar-liquid-capsule.is-pressed {
  border-radius: 38rpx;
  transform: translate(-50%, -50%) scale(1.035);
  box-shadow:
    0 10rpx 28rpx rgba(30, 70, 40, 0.10),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.84);
}

.tabbar-pill.is-hydrating .tabbar-liquid-capsule {
  transition: none;
}

.tabbar-pill.is-dragging .tabbar-liquid-capsule {
  transition:
    left 75ms ease-out,
    transform 75ms ease-out,
    box-shadow 120ms ease,
    opacity 120ms ease;
}

.tabbar-pill.is-switching .tabbar-liquid-capsule {
  transition:
    left 180ms cubic-bezier(0.2, 0.9, 0.18, 1),
    transform 180ms cubic-bezier(0.2, 0.9, 0.18, 1),
    box-shadow 150ms ease,
    opacity 120ms ease;
}

.tabbar-item {
  position: relative;
  z-index: 1;
  flex: 0 1 118rpx;
  width: 118rpx;
  min-width: 92rpx;
  max-width: 118rpx;
  height: 88rpx;
  border-radius: 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7E8B80;
  font-weight: 650;
  text-align: center;
  transform: translateY(0) scale(1);
  transition:
    color 180ms ease,
    opacity 180ms ease,
    background 180ms ease,
    transform 180ms cubic-bezier(0.2, 0.9, 0.18, 1.12);
}

.tabbar-item.is-active {
  color: #3D7A2E;
  transform: translateY(-1rpx) scale(1.02);
}

.tabbar-item.is-pressed {
  background: rgba(127, 191, 77, 0.08);
  transform: translateY(-3rpx) scale(1.035);
}

.tabbar-item.is-drag-target {
  color: #3D7A2E;
  transform: translateY(-4rpx) scale(1.06);
}

.tabbar-pill.is-dragging .tabbar-item:not(.is-drag-target) {
  opacity: 0.54;
  transform: translateY(1rpx) scale(0.94);
}

.tabbar-icon {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  /* SVG 用 mask 而非 background-image：mask + currentColor 让图标颜色继续跟着
     .tabbar-item 的 color 过渡走，选中态不必另备一套绿色图。 */
  background-color: currentColor;
  -webkit-mask-position: center;
          mask-position: center;
  -webkit-mask-repeat: no-repeat;
          mask-repeat: no-repeat;
  -webkit-mask-size: 100% 100%;
          mask-size: 100% 100%;
}

.tabbar-label {
  max-width: 100%;
  margin-top: 4rpx;
  padding: 0 2rpx;
  font-size: 19rpx;
  font-weight: 650;
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.icon-home {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
          mask-image: url("data:image/svg+xml;base64,");
}

.icon-community {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
          mask-image: url("data:image/svg+xml;base64,");
}

.icon-messages {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
          mask-image: url("data:image/svg+xml;base64,");
}

.icon-planner {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
          mask-image: url("data:image/svg+xml;base64,");
}

.icon-profile {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
          mask-image: url("data:image/svg+xml;base64,");
}

.tabbar-badge {
  position: absolute;
  top: 4rpx;
  right: 14rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #E5484D;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(229, 72, 77, 0.32);
  z-index: 3;
  pointer-events: none;
}
